# =============================================================================
# Super Store Sales OS — variables de entorno
# =============================================================================
# Esta es la unica plantilla de entorno que SI se versiona. Copiala a
# `.env.local` y llena los valores reales. `.env` y `.env.local` estan
# ignorados por `.env*`; `!.env.example` exceptua solo esta plantilla.
#
# `pnpm env:local` genera y ACTUALIZA .env.local automaticamente: escribe los
# valores locales y respeta cualquier clave que ya hayas puesto a mano.
# Ver blueprint.md §17 para la columna "requerida desde el paso".
# =============================================================================

# --- Base de datos ------------------------------------------------------------

# Conexion de la APLICACION. En local es el Postgres de Supabase local.
# En produccion DEBE ser la URL del POOLER (puerto 6543), nunca la directa:
# conexiones por request en serverless contra Postgres sin pooler agotan
# conexiones en el primer pico. Supabase Dashboard > Project Settings >
# Database > Connection string > Transaction pooler.
# Requerida desde el paso 1.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Conexion para migraciones y scripts. Lo que importa NO es el host sino el modo:
# un pooler en modo TRANSACCION pierde advisory locks y prepared statements, y las
# migraciones los necesitan. El modo SESION los conserva.
#
# En Supabase, `db.<ref>.supabase.co` resuelve solo a IPv6 y es inalcanzable desde
# una red IPv4 —el sintoma es "Network is unreachable", que no menciona IPv6—. La
# ruta que si funciona es el pooler en modo sesion, puerto 5432:
#   postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Verificado contra el proyecto real el 21-ago-2026.
# Requerida desde el paso 1.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Base de PRUEBAS: el Postgres de docker-compose.yml. Las pruebas nunca
# comparten base con desarrollo. La levanta `pnpm db:up`.
# Requerida desde el paso 1.
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/super_store_test"

# --- Supabase (Auth + Storage) ------------------------------------------------
# En local: corre `pnpm supabase:start` y luego `pnpm env:local`, que copia
# estos tres valores desde `supabase status -o env`.
# En produccion: Supabase Dashboard > Project Settings > API.

# URL de la API de Supabase. Local: http://127.0.0.1:54321
# Requerida desde el paso 3.
NEXT_PUBLIC_SUPABASE_URL=""

# Publishable key nueva (`sb_publishable_...`). Llega al navegador: es publica.
# Requerida desde el paso 3.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Secret key nueva (`sb_secret_...`). SALTA RLS. Jamas en el cliente,
# jamas en un log. Solo la usan los modulos de src/server/.
# Requerida desde el paso 3.
SUPABASE_SECRET_KEY=""

# Bucket privado de Supabase Storage donde viven las grabaciones de los lives.
# Lo crea `pnpm db:seed`. Requerida desde el paso 14.
# Tope por archivo del bucket, en bytes. Lo decide el PLAN de Supabase, no este
# proyecto: el gratuito corta en 50 MB (52428800) y rechaza crear un bucket que
# pida mas. En un plan pago se puede subir.
SUPABASE_MAX_UPLOAD_BYTES="209715200"

SUPABASE_RECORDINGS_BUCKET="live-recordings"

# --- Gemini (capa de IA) ------------------------------------------------------

# Llave de la API de Gemini. Se envia como header `x-goog-api-key`, nunca
# como Bearer: un Bearer con esta llave devuelve 401 UNAUTHENTICATED.
# Ningun gate del §9 la necesita: las pruebas inyectan un cliente falso en el
# gateway. Se requiere para usar el producto de verdad desde el paso 7.
GEMINI_API_KEY=""

# Base de la API del proveedor. Separada del codigo para que ningun literal de la
# documentacion quede incrustado, y para poder apuntar a un proxy o a otra version
# sin tocar el gateway. Requerida desde el paso 7.
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

# Id del modelo por defecto para TODOS los call sites. Nunca se escribe un id de
# modelo en el codigo (blueprint.md §17). Requerida desde el paso 7.
AI_MODEL_DEFAULT="gemini-3.1-flash-lite"

# Id del modelo del tier pequeno. Declarado y NO usado todavia: la regla es
# empezar un tier arriba y bajar solo con un eval que lo respalde. El candidato
# a bajar es el clasificador de intencion del Copilot. Requerida desde el paso 7.
AI_MODEL_SMALL="gemini-3-flash-preview"

# Limite por proceso para que un analisis largo no bloquee el Copilot.
# Requerida desde el paso 7.
AI_MAX_CONCURRENCY="4"

# --- Deepgram (transcripcion) -------------------------------------------------
# https://console.deepgram.com/ > API Keys. Claude no transcribe audio.
# Se llama por REST con `fetch`, sin SDK (blueprint.md §11).

# Requerida desde el paso 14.
DEEPGRAM_API_KEY=""

# Base de la API. Separada del codigo para que ningun literal tomado de la
# documentacion quede incrustado. Requerida desde el paso 14.
DEEPGRAM_BASE_URL="https://api.deepgram.com/v1/listen"

# Modelo y lenguaje de STT. VERIFICAR contra la documentacion vigente de
# Deepgram antes de la primera llamada real. Requerida desde el paso 14.
DEEPGRAM_MODEL="nova-3"
DEEPGRAM_LANGUAGE="es-419"

# Secreto compartido que Deepgram devuelve en el callback. Genera uno con
# `openssl rand -hex 32`. El endpoint lo compara en tiempo constante y responde
# 401 si no coincide. Requerida desde el paso 14.
DEEPGRAM_CALLBACK_SECRET=""

# URL publica que Deepgram puede alcanzar para el callback. En local usa un tunel
# (por ejemplo `ngrok http 3000`) o deja vacio y encola manualmente.
# Requerida desde el paso 14.
PUBLIC_BASE_URL="http://127.0.0.1:3000"

# --- Groq (transcripcion alternativa) -----------------------------------------
# https://console.groq.com/keys. Tier gratuito permanente para Whisper:
# 8 horas de audio al dia, 20 peticiones por minuto, 25 MB por archivo.
# No hace diarizacion; este producto no la usa (nada parsea [Speaker N]).
# Se llama por REST con `fetch`, sin SDK, igual que los demas proveedores.

GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="whisper-large-v3-turbo"

# Que proveedor transcribe: "deepgram" o "groq".
TRANSCRIPTION_PROVIDER="deepgram"

# Tope de bytes que se le manda al proveedor. Si el audio pesa mas, se
# recomprime con ffmpeg antes de enviarlo. 25 MB es el limite del tier gratuito
# de Groq; Deepgram admite hasta 2 GB, asi que con el puedes subirlo.
TRANSCRIPTION_MAX_BYTES="26214400"

# --- Operacion ----------------------------------------------------------------

# Secreto del cron de retencion. Vercel lo envia como
# `Authorization: Bearer <secreto>`. Genera uno con `openssl rand -hex 32`.
# Requerida desde el paso 16.
CRON_SECRET=""

# Dias de retencion de grabaciones y transcripciones. Las transcripciones
# contienen PII de clientes (nombres, telefonos, condiciones de salud) dichos en
# el chat del live. Requerida desde el paso 16.
RECORDING_RETENTION_DAYS="90"
